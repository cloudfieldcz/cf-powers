#!/usr/bin/env python3
"""Expose this checkout through Codex standalone skill discovery."""
import argparse
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=['install', 'uninstall'])
parser.add_argument('--skills-dir', type=Path, default=Path.home() / '.agents/skills',
                    help='Discovery directory (default: ~/.agents/skills)')
args = parser.parse_args()
source = Path(__file__).resolve().parents[1] / 'skills'
link = args.skills_dir.expanduser().absolute() / 'cf-powers'
exists = link.exists() or link.is_symlink()
ours = link.is_symlink() and link.resolve() == source
if exists and not ours:
    parser.exit(1, f'Refusing to replace or remove unrelated path: {link}\n')
if args.action == 'install':
    link.parent.mkdir(parents=True, exist_ok=True)
    if not ours:
        link.symlink_to(source, target_is_directory=True)
    print(f'Installed: {link} -> {source}. Start a new Codex session.')
else:
    if ours:
        link.unlink()
    print(f'Removed standalone link: {link}. Checkout retained.')
